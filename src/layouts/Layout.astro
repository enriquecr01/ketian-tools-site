---
import "../styles/global.css";
import { defaultLang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
---

<html lang={lang}>
  <head>
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const isDark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t("meta.title")}</title>
    <meta name="description" content={t("meta.description")} />
    <link rel="canonical" href={lang === defaultLang ? "/" : `/${lang}/`} />
    <link rel="alternate" hreflang="es" href="/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="x-default" href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background text-foreground">
    <slot />
  </body>
</html>
